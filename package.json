{
  "name": "lrc-avg-workspace",
  "private": true,
  "description": "LrC-AVG monorepo root: engine (Node/TS MCP server), the Deck (hud, Tauri) and spike scripts.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "engine",
    "spikes",
    "hud"
  ],
  "scripts": {
    "build": "npm run build -w engine",
    "test": "npm test -w engine",
    "typecheck": "npm run typecheck -w engine && npm run typecheck -w spikes && npm run typecheck -w hud",
    "phase1:check": "npm run build && node engine/dist/devtools/phase1-check-cli.js",
    "desktop:install": "npm run build && node engine/dist/devtools/install-desktop-config-cli.js",
    "package": "npm run clean -w engine && npm run build && node engine/dist/devtools/package-cli.js",
    "phase2:check": "npm run build && node engine/dist/devtools/phase2-check-cli.js",
    "schemas": "npm run build && node engine/dist/devtools/write-schemas-cli.js",
    "phase3:check": "npm run build && node engine/dist/devtools/phase3-check-cli.js",
    "phase4:check": "npm run build && node engine/dist/devtools/phase4-check-cli.js",
    "phase5:check": "npm run build && node engine/dist/devtools/phase5-check-cli.js",
    "goldens": "npm run build && node engine/dist/devtools/goldens-cli.js",
    "preset:capture": "npm run build && node engine/dist/devtools/preset-capture-cli.js",
    "preset:pin": "npm run build && node engine/dist/devtools/preset-pin-cli.js",
    "wb:check": "npm run build && node engine/dist/devtools/wb-check-cli.js",
    "s10:check": "npm run build && node engine/dist/devtools/s10-check-cli.js",
    "offline:check": "npm run build && node engine/dist/devtools/offline-check-cli.js",
    "ai:probe": "npm run build && node engine/dist/devtools/ai-probe-cli.js",
    "masks:carry": "npm run build && node engine/dist/devtools/mask-carry-probe-cli.js",
    "masks:combine": "npm run build && node engine/dist/devtools/mask-combine-probe-cli.js",
    "masks:crop": "npm run build && node engine/dist/devtools/mask-crop-probe-cli.js",
    "masks:kinds": "npm run build && node engine/dist/devtools/mask-combine-probe-cli.js --kinds",
    "effects:probe": "npm run build && node engine/dist/devtools/effects-probe-cli.js",
    "stall:check": "npm run build && node engine/dist/devtools/stall-check-cli.js",
    "intents:check": "npm run build && node engine/dist/devtools/intents-check-cli.js",
    "phase8:check": "npm run build && node engine/dist/devtools/phase8-check-cli.js",
    "deck:build": "npm run build && npm run build -w hud",
    "deck:probe": "npm run build && node hud/probe/probe.ts",
    "deck:states": "npm run build && node hud/probe/states.ts",
    "deck:idle-probe": "npm run build && node hud/probe/idle.ts",
    "deck:menu": "npm run build && node hud/probe/menu.ts",
    "phase7:check": "npm run build && node hud/probe/check/check.ts",
    "clients:probe": "npm run build && npm run probe -w engine",
    "clients:check": "npm run deck:build && node engine/dist/devtools/clients-check-cli.js",
    "setup:build": "node tools/setup/build.ts",
    "setup:install": "node tools/setup/install.ts",
    "setup:lock-check": "node tools/setup/lock-check.ts",
    "cleanroom": "npm run build && node engine/dist/devtools/cleanroom-cli.js",
    "sandbox:check": "npm run build && node engine/dist/devtools/sandbox-cli.js",
    "phase9:local": "npm run build && node engine/dist/devtools/phase9-local-cli.js",
    "arch:check": "depcruise engine/src --config .dependency-cruiser.cjs --ignore-known",
    "arch:graph": "node tools/arch-graph.ts"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "dependency-cruiser": "18.6.0"
  }
}
