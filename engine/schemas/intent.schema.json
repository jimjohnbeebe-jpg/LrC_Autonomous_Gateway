{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrc-avg/intent.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "description": "lower case letters, digits and _; the file is <id>.json"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "prose instructions to Claude"
    },
    "profile": {
      "description": "the profile pass 0 sets, per pipeline: raw such as \"Adobe Landscape\" or \"Camera Standard\", rendered \"Color\" or \"Monochrome\"; leave out to keep the photo's",
      "type": "object",
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "rendered": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "raw",
        "rendered"
      ],
      "additionalProperties": false
    },
    "priors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "priors for both pipelines (not temperature or tint: see priors_by_pipeline)"
    },
    "priors_by_pipeline": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
        },
        "rendered": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
        }
      },
      "additionalProperties": false,
      "description": "priors for one pipeline only, added to `priors` on a photo of that pipeline; temperature and tint go here, in Kelvin on raw and in relative units (-100..100) on rendered"
    },
    "variants": {
      "description": "three named prior sets for Variants mode (Phase 4)",
      "type": "object",
      "properties": {
        "A": {
          "type": "object",
