{
  "name": "lrc-avg",
  "version": "0.22.0",
  "description": "LrC-AVG engine: stdio MCP server, metrics, session state and Lightroom bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimjohnbeebe-jpg/LrC_Autonomous_Gateway.git",
    "directory": "engine"
  },
  "type": "module",
  "bin": {
    "lrc-avg": "dist/mcp/main.js",
    "lrc-avg-setup": "dist/setup/setup-cli.js"
  },
  "files": [
    "dist",
    "!dist/devtools",
    "!dist/**/*.map",
    "intents",
    "schemas",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "sharp": "0.35.4",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.2",
    "luaparse": "0.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
