{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lrc-avg/intent.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ],
      "description": "3 (2 still loads, without set and references)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "description": "lower case letters, digits and _; the file is <id>.json"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "prose instructions to the AI"
    },
    "profile": {
      "description": "the profile pass 0 sets, per pipeline: raw such as \"Adobe Landscape\" or \"Camera Standard\", rendered \"Color\" or \"Monochrome\"; leave out to keep the photo's",
      "type": "object",
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "rendered": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "raw",
        "rendered"
      ],
      "additionalProperties": false
    },
    "priors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "priors for both pipelines (not temperature or tint: see priors_by_pipeline)"
    },
    "priors_by_pipeline": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
        },
        "rendered": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
        }
      },
      "additionalProperties": false,
      "description": "priors for one pipeline only, added to `priors` on a photo of that pipeline; temperature and tint go here, in Kelvin on raw and in relative units (-100..100) on rendered"
    },
    "set": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "canonical parameter name -> value, written at pass 0 as given (absolute; schema v3)"
    },
    "set_by_pipeline": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, written at pass 0 as given (absolute; schema v3)"
        },
        "rendered": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "canonical parameter name -> value, written at pass 0 as given (absolute; schema v3)"
        }
      },
      "additionalProperties": false,
      "description": "absolute values for one pipeline only (schema v3); temperature and tint go here, Kelvin on raw, relative -100..100 on rendered"
    },
    "variants": {
      "description": "three named prior sets for Variants mode (Phase 4)",
      "type": "object",
      "properties": {
        "A": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "priors": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
            },
            "priors_by_pipeline": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                },
                "rendered": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                }
              },
              "additionalProperties": false,
              "description": "priors for one pipeline only, added to `priors` on a photo of that pipeline; temperature and tint go here, in Kelvin on raw and in relative units (-100..100) on rendered"
            }
          },
          "required": [
            "label",
            "priors"
          ],
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "priors": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
            },
            "priors_by_pipeline": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                },
                "rendered": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                }
              },
              "additionalProperties": false,
              "description": "priors for one pipeline only, added to `priors` on a photo of that pipeline; temperature and tint go here, in Kelvin on raw and in relative units (-100..100) on rendered"
            }
          },
          "required": [
            "label",
            "priors"
          ],
          "additionalProperties": false
        },
        "C": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "priors": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
            },
            "priors_by_pipeline": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                },
                "rendered": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "description": "canonical parameter name -> value, applied at pass 0: a number is added to the photo's current value; a switch, boolean or curve is set as given"
                }
              },
              "additionalProperties": false,
              "description": "priors for one pipeline only, added to `priors` on a photo of that pipeline; temperature and tint go here, in Kelvin on raw and in relative units (-100..100) on rendered"
            }
          },
          "required": [
            "label",
            "priors"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "A",
        "B",
        "C"
      ],
      "additionalProperties": false
    },
    "guardrail_overrides": {
      "description": "replaces the default clipping limits (0.5 % high, 1.0 % low; AVG-009) for this intent",
      "type": "object",
      "properties": {
        "clip_high_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "clip_low_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "clip_baseline": {
      "description": "true: pass 0 pulls clipping under the limits, and a pass corrects an end over before it (default false: only what the pass caused; issue #130)",
      "type": "boolean"
    },
    "regions_expected": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "skin",
          "fur",
          "sky",
          "custom"
        ]
      }
    },
    "convergence_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "allow_probe": {
      "description": "lr_probe is off in autonomous mode unless this is true",
      "type": "boolean"
    },
    "references": {
      "type": "object",
      "properties": {
        "uuids": {
          "description": "1-8 catalog photo uuids",
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "collection": {
          "description": "a catalog collection by name, or \"Set / Name\"; its first 8 photos are used",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false,
      "description": "photos the session measures at begin; every pass then reports where the photo lies against their range (reported only, never a target)"
    }
  },
  "required": [
    "schema_version",
    "id",
    "label",
    "category",
    "brief",
    "priors"
  ],
  "additionalProperties": false,
  "description": "LrC-AVG intent, schema v3 (v2 still loads)"
}
