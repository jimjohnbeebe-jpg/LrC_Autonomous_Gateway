{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LrC-AVG HUD",
  "mainBinaryName": "LrC-AVG HUD",
  "version": "0.3.1",
  "identifier": "com.lrcavg.hud",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LrC-AVG Deck",
        "width": 1200,
        "height": 44,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:*; style-src 'self'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
