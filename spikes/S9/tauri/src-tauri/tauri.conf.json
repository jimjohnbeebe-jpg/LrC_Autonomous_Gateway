{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LrC-AVG S9 HUD",
  "version": "0.0.0",
  "identifier": "com.lrcavg.spike.s9hud",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LrC-AVG HUD (S9)",
        "width": 1280,
        "height": 44,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:*; style-src 'self'; font-src 'self'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
