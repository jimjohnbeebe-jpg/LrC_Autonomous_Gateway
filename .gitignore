# Fixtures stay on disk, never in git (raw files + Lightroom sidecars)
fixtures/*.NEF
fixtures/*.dng
fixtures/*.NEF.xmp
fixtures/*.xmp
# Lightroom-exported JPEGs Jim drops in for spike S3 (sharp cannot decode the NEFs)
fixtures/*.jpg
fixtures/*.jpeg
# The files Jim makes for spike S10 (PSB, 16/32-bit and CMYK TIFF, JPEG XL): renders of his photos
fixtures/S10/

# Golden JPEGs are renders of Jim's photos: on disk only, never in the public repo (Phase 3 decision 3,
# Jim 2026-09-26). Their hashes and expected metrics are committed instead.
tests/golden/*.jpg
tests/golden/*.jpeg
engine/tests/golden/*.jpg
engine/tests/golden/*.jpeg

# Dev session logs (keep the folder)
logs/*
!logs/.gitkeep

# Node / build
node_modules/
dist/

# Local environment and scratch
.env
*.tmp

# Stack rule (no Python anywhere): the upstream Automaat snapshot ships a Python
# skill script; it stays on disk unmodified (vendor is reference-only) but is
# never tracked here. See docs/AUTOMAAT_SURVEY.md §8.
vendor/automaat/**/*.py

# Graphify per-repo knowledge graph (derived, machine-local; rebuild with `graphify update .`)
graphify-out/

# Release assets from `npm run package` (attached to GitHub Releases, never committed)
release/

# Spike S9: the Tauri build output and the generated UI (npm run s9:build -w spikes)
spikes/S9/tauri/src-tauri/target/
spikes/S9/tauri/src-tauri/gen/
spikes/S9/tauri/ui-dist/

# The Deck (hud): the Tauri build output and the generated UI (npm run deck:build)
hud/src-tauri/target/
hud/src-tauri/gen/
hud/ui-dist/
