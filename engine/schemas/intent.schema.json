    "guardrail_overrides": {
      "description": "replaces the default clipping limits (0.5 % high, 1.0 % low; AVG-009) for this intent",
      "type": "object",
      "properties": {
        "clip_high_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "clip_low_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "regions_expected": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "skin",
          "fur",
          "sky",
          "custom"
        ]
      }
    },
    "convergence_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "allow_probe": {
      "description": "lr_probe is off in autonomous mode unless this is true",
      "type": "boolean"
    }
