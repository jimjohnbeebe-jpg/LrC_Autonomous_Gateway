# Fixtures stay on disk, never in git (raw files + Lightroom sidecars)
fixtures/*.NEF
fixtures/*.dng
fixtures/*.NEF.xmp
# Lightroom-exported JPEGs Jim drops in for spike S3 (sharp cannot decode the NEFs)
fixtures/*.jpg
fixtures/*.jpeg

# Golden JPEGs are renders of Jim's photos: on disk only, never in the public repo (Phase 3 decision 3,
# Jim 2026-09-26). Their hashes and expected metrics are committed instead.
tests/golden/*.jpg
tests/golden/*.jpeg

# Dev session logs (keep the folder)
logs/*
!logs/.gitkeep

# Node / build
node_modules/
dist/

# Local environment and scratch
.env
*.tmp

# Stack rule (no Python anywhere): the upstream Automaat snapshot ships a Python
# skill script; it stays on disk unmodified (vendor is reference-only) but is
# never tracked here. See docs/AUTOMAAT_SURVEY.md §8.
vendor/automaat/**/*.py

# Graphify per-repo knowledge graph (derived, machine-local; rebuild with `graphify update .`)
graphify-out/
